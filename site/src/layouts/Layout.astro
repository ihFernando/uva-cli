---
interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'uva-cli — Git workflows, beautifully automated',
  description = 'Interactive CLI for conventional commits and smart branch naming. Config-driven formats, ticket integration, and a delightful developer experience.',
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <title>{title}</title>

    <!-- Prevent flash of wrong theme -->
    <script is:inline>
      (function () {
        const t = localStorage.getItem('uva-theme') ?? 'dark';
        document.documentElement.classList.toggle('dark', t === 'dark');
      })();
    </script>

    <link rel="icon" href="/logo.svg" type="image/svg+xml" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&family=JetBrains+Mono:wght@400;500&display=swap"
      rel="stylesheet"
    />

    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
  </head>
  <body
    class="bg-uva-50 dark:bg-[#0d0a1a] text-uva-ink dark:text-white font-sans antialiased transition-colors duration-200 selection:bg-uva-200 dark:selection:bg-uva-700/40 selection:text-uva-900 dark:selection:text-uva-200"
  >
    <slot />
  </body>
</html>
