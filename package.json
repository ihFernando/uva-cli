{
  "name": "uva-cli",
  "version": "1.3.0",
  "description": "UVA CLI — Interactive Git workflow automation for teams",
  "type": "module",
  "bin": {
    "uva": "./bin.mjs"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "files": [
    "bin.mjs",
    "commands/",
    "lib/",
    "templates/"
  ],
  "keywords": [
    "cli",
    "git",
    "conventional-commits",
    "workflow",
    "automation",
    "interactive",
    "branching"
  ],
  "license": "MIT",
  "scripts": {
    "test": "node --test tests/slugify.test.mjs tests/format.test.mjs",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "lefthook install",
    "prepublishOnly": "npm run format:check && npm run lint && npm test"
  },
  "dependencies": {
    "@clack/prompts": "^0.9.0",
    "commander": "^12.0.0",
    "picocolors": "^1.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.10.0",
    "lefthook": "^2.1.12",
    "prettier": "^3.9.6"
  }
}
